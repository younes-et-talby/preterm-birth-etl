        <mxCell id="B26GLugQ7-ulRmH_6kYr-98" parent="1" style="verticalLabelPosition=bottom;shadow=0;dashed=0;align=center;html=1;verticalAlign=top;strokeWidth=1;shape=mxgraph.mockup.markup.line;strokeColor=#d6b656;fontStyle=1;fillColor=#fff2cc;" value="" vertex="1">
