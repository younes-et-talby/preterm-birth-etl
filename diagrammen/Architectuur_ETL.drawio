        </mxCell>
        <mxCell id="B26GLugQ7-ulRmH_6kYr-99" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;fillColor=none;strokeColor=none;" value="&amp;nbsp;&lt;div&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt;Opslag:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Ongewijzigde&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;CSV-bronbestanden&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Originele CBS-Excelbestanden&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt;Verwerking:&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Bronbestanden ongewijzigd naar Bronze kopiëren.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;CSV-bestanden inlezen.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Kolomnamen en aantallen rijen en kolommen controleren.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;EDA: verdelingen, lege waarden en onbekendcodes onderzoeken.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;b&gt;Controle en privacy:&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Bestandsnamen, bronversies en publicatiedatums vastleggen.&lt;/li&gt;&lt;li&gt;Geen vertrouwelijke gegevens of wachtwoorden in GitLab bewaren.&lt;/li&gt;&lt;li&gt;Alleen aantallen en controlemeldingen loggen.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="501" width="220" x="440" y="466" as="geometry" />
        </mxCell>
        <mxCell id="B26GLugQ7-ulRmH_6kYr-100" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;fillColor=none;strokeColor=none;" value="&amp;nbsp;&lt;div&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt;Opslag:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Parquet-bestand met gecontroleerde geboorteregistraties en gekoppelde CBS-SES-WOA.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt;Verwerking:&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Benodigde kolommen selecteren en datatypes instellen.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Waarden, onbekendcodes en logische combinaties controleren.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Vroeggeboorte afleiden: geldige zwangerschapsduur korter dan 259 dagen. Bij ontbrekende of ongeldige duur blijft de uitkomst onbekend.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;SES koppelen op PC4 en hetzelfde jaar (LEFT JOIN). Zonder passende score blijft SES leeg.&lt;/span&gt;.&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;b&gt;Controle en privacy:&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;SES-tabel controleren op unieke combinaties van PC4 en jaar.&lt;/li&gt;&lt;li&gt;Na de SES-koppeling blijft het aantal geboorteregistraties gelijk.&lt;/li&gt;&lt;li&gt;Postcode, provincie en stedelijkheid controleren met de CBS-tabellen&lt;/li&gt;&lt;li&gt;Alleen benodigde velden bewaren en toegang tot Silver beperken&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="560" width="220" x="719" y="466" as="geometry" />
        </mxCell>
        <mxCell id="B26GLugQ7-ulRmH_6kYr-101" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;fillColor=none;strokeColor=none;" value="&amp;nbsp;&lt;div&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt;Opslag:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Provincie-jaartabel in Parquet en DuckDB. Een rij per provincie en jaar: maximaal 120 rijen.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt;Verwerking:&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Groeperen op bekende provincie en jaar.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Vroeggeboorten en registraties met een geldige zwangerschapsduur tellen.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Vroeggeboortepercentage, gemiddelde CBS-SES-WOA en SES-dekking berekenen.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Registraties met een onbekende provincie apart verantwoorden.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;b&gt;Controle en privacy:&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Controleren op dubbele provincie-jaarcombinaties en sluitende tellingen.&lt;/li&gt;&lt;li&gt;PC4 weglaten; kleine groepen en herleidbare totalen afschermen.&lt;/li&gt;&lt;li&gt;Nieuwe uitvoer pas beschikbaar maken als alle controles slagen. Bij fouten blijft de vorige uitvoer beschikbaar.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="501" width="220" x="1000" y="466" as="geometry" />
        </mxCell>
