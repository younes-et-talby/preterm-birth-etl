        <mxCell id="privacy_setup" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#D8E3E8;" value="&lt;div style=&quot;font-size: 21px; font-weight: bold; color: rgb(34, 34, 34);&quot;&gt;Privacy · voor de run&lt;/div&gt;&lt;div style=&quot;font-size: 20px; line-height: 1.34; color: rgb(85, 85, 85); margin-top: 12px;&quot;&gt;Gebruik een toegestane omgeving&lt;br&gt;en beperk toegang tot data en logs.&lt;br&gt;&lt;br&gt;Echte Perined-data blijven in de&lt;br&gt;goedgekeurde beveiligde omgeving.&lt;br&gt;&lt;br&gt;GitLab bevat code en documentatie,&lt;br&gt;geen vertrouwelijke data, uitvoer&lt;br&gt;of wachtwoorden.&lt;/div&gt;" vertex="1">
          <mxGeometry height="325" width="410" x="85" y="260" as="geometry" />
        </mxCell>
        <mxCell id="minimum_fields" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#D8E3E8;" value="&lt;div style=&quot;font-size: 20px; font-weight: bold; color: rgb(34, 34, 34);&quot;&gt;Invoer | Vier tabellen&lt;/div&gt;&lt;div style=&quot;line-height: 1.34; margin-top: 12px; font-size: 19px;&quot;&gt;&lt;span style=&quot;color: rgb(85, 85, 85);&quot;&gt;1.&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;Synthetische geboorteregistraties (CSV).&lt;/span&gt;&lt;br&gt;2.&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;CBS-SES-WOA per PC4 en jaar&lt;/span&gt;.&lt;br&gt;3. CBS-stedelijkheid per PC4 (2024).&lt;br&gt;4. Afgeleide provinciecontrole per PC4 (2024).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.34; margin-top: 12px; font-size: 19px;&quot;&gt;&lt;span style=&quot;color: rgb(85, 85, 85);&quot;&gt;&lt;br&gt;Originele CBS-downloads blijven bewaard.&lt;br&gt;PC4 wordt niet in Gold opgenomen.&lt;br&gt;&lt;br&gt;SES-percentiel is geen CBS-SES-WOA.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="335" width="410" x="1320" y="260" as="geometry" />
        </mxCell>
        <mxCell id="expected_missing" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#D8E3E8;" value="&lt;div style=&quot;color: rgb(34, 34, 34);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 20px;&quot;&gt;&lt;font color=&quot;#222222&quot;&gt;&lt;b&gt;Bronze · Ontbrekend is geen nul&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(34, 34, 34);&quot;&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;Tel lege velden per kolom. Een leeg veld betekent niet automatisch nul.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="116" width="410" x="1320" y="610" as="geometry" />
        </mxCell>
        <mxCell id="quality_rules" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#D8E3E8;fontColor=light-dark(#050505, #ededed);" value="&lt;div style=&quot;font-size: 20px; font-weight: bold;&quot;&gt;Silver | Kwaliteitscontroles&lt;/div&gt;&lt;div style=&quot;line-height: 1.34; margin-top: 12px;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; font-size: 19px;&quot;&gt;Controleer of de zwangerschapsduur in dagen past bij het aantal hele weken&lt;/span&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.34; margin-top: 12px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;Controleer of het aantal zwangerschappen hoger is dan het aantal eerdere bevallingen.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.34; margin-top: 12px;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;Onderzoek onverwachte waarden voordat je gegevens aanpast. Verwijder statistische uitschieters niet automatisch.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="410" x="1320" y="790" as="geometry" />
        </mxCell>
        <mxCell id="target_rules" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#D8E3E8;" value="&lt;div style=&quot;font-size: 20px; font-weight: bold; color: rgb(34, 34, 34);&quot;&gt;Silver | Uitkomst en onbekend&lt;/div&gt;&lt;div style=&quot;font-size: 19px; line-height: 1.34; color: rgb(85, 85, 85); margin-top: 12px;&quot;&gt;Geldige duur in dit scenario:&lt;br&gt;168-300 dagen, gehele waarden.&lt;br&gt;Daarbuiten of leeg: uitkomst onbekend.&lt;br&gt;&lt;br&gt;Vroeggeboorte: duur &amp;lt; 259 dagen.&lt;br&gt;Onbekende stedelijkheid wordt niet&lt;br&gt;als niet-stedelijk behandeld.&lt;/div&gt;" vertex="1">
          <mxGeometry height="255" width="410" x="1320" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="eda_choices" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#D8E3E8;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 20px;&quot;&gt;&lt;font color=&quot;#333300&quot;&gt;&lt;b&gt;EDA ---&amp;gt; keuzes in de ETL&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(85, 85, 85);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 19px;&quot;&gt;&lt;font&gt;100.000 registraties en 46 kolommen&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 19px; font-weight: normal; background-color: transparent;&quot;&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.34; margin-top: 12px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;color: rgb(85, 85, 85);&quot;&gt;&lt;br&gt;&lt;font&gt;&lt;font&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;37.613 registraties hebben een onbekende provincie: apart tellen en niet zelf aanvullen.&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font&gt;&lt;font&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;Behoud registraties met ontbrekend SES-percentiel, leeftijd of pariteit. Houd per kenmerk bij hoeveel waarden bekend zijn&lt;/span&gt;&lt;/font&gt;&lt;font&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 19px; color: rgb(85, 85, 85);&quot;&gt;62.387 registraties met bekende provincie leveren 120 provincie-jaarcombinaties op. De kleinste geldige noemer is 88 registraties&lt;/span&gt;&lt;/font&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="345" width="410" x="85" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="aggregate_rules" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#D8E3E8;" value="&lt;div style=&quot;font-weight: bold; color: rgb(34, 34, 34);&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Gold | Percentage en beschikbare gegevens&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 18px; line-height: 1.34; color: rgb(85, 85, 85); margin-top: 12px;&quot;&gt;Vroeggeboortepercentage = 100 × aantal vroeggeboorten / aantal registraties met een geldige zwangerschapsduur.&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164)); background-color: transparent;&quot;&gt;Bewaar per kenmerk het aantal bekende waarden.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="410" x="1320" y="1385" as="geometry" />
        </mxCell>
        <mxCell id="output_rules" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#D8E3E8;" value="&lt;div style=&quot;font-size: 20px; font-weight: bold; color: rgb(34, 34, 34);&quot;&gt;Gold | Eindcontrole&lt;/div&gt;&lt;div style=&quot;font-size: 19px; line-height: 1.34; color: rgb(85, 85, 85); margin-top: 12px;&quot;&gt;Elke combinatie van provincie en jaar komt een keer voor&lt;span style=&quot;color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164)); background-color: transparent;&quot;&gt;.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164)); background-color: transparent;&quot;&gt;De aantallen sluiten aan op de geselecteerde registraties.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164)); background-color: transparent;&quot;&gt;Percentages liggen tussen 0 en 100.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164)); background-color: transparent;&quot;&gt;Bij nul registraties met geldige zwangerschapsduur blijft het percentage leeg.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 19px; line-height: 1.34; color: rgb(85, 85, 85); margin-top: 12px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164)); background-color: transparent;&quot;&gt;Meld ontbrekende combinaties en vul deze niet met nul.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164)); background-color: transparent;&quot;&gt;Neem geen individuele registraties of PC4 op in de provinciale tabel&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164)); background-color: transparent;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 19px; line-height: 1.34; color: rgb(85, 85, 85); margin-top: 12px;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="307" width="410" x="1320" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="run_failures" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFF8F7;strokeColor=#D8E3E8;" value="&lt;div style=&quot;font-size: 20px; font-weight: bold; color: rgb(165, 60, 66);&quot;&gt;Bij iedere technische fout&lt;/div&gt;&lt;div style=&quot;line-height: 1.34; margin-top: 12px; color: rgb(85, 85, 85);&quot;&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;Stop de verwerking en verwijder tijdelijke werkbestanden. Bewaar de vorige geldige resultaten&lt;/span&gt;&lt;/font&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(85, 85, 85);&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;Meld alleen bij welke stap het misgaat en om welk soort fout het gaat. Neem geen individuele gegevens, volledige tabellen of wachtwoorden op in foutmeldingen&lt;/span&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="410" x="85" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="output_privacy" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#D8E3E8;" value="&lt;div style=&quot;font-size: 19px; font-weight: bold;&quot;&gt;&lt;span style=&quot;color: rgb(51, 51, 0);&quot;&gt;4-5 | Privacy en herhaalbaarheid&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.34; margin-top: 12px;&quot;&gt;&lt;span style=&quot;color: rgb(85, 85, 85);&quot;&gt;&lt;font&gt;&lt;font&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Leg de gebruikte bronbestanden, codeversie, softwareversies en verwerkingsregels vast. Bewaar controles en tellingen in een afgeschermd verslag.&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font&gt;&lt;font&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Neem geen individuele gegevens of wachtwoorden op in logs. Sla geen individuele gegevens op als resultaat van een Prefect-taak&lt;/span&gt;&lt;/font&gt;&lt;font&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font&gt;&lt;font&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;De resultaten blijven intern. Scherm in het exportvoorstel jaren met kleine groepen af. Laat het voorstel voor het delen controleren. Samengevoegde gegevens zijn niet automatisch anoniem&lt;/span&gt;&lt;/font&gt;&lt;font&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="385" width="410" x="1320" y="1910" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
